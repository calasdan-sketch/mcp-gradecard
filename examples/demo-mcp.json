{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.1.14", "/home/me/projects"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_EXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE00" }
    },
    "vendor-crm": {
      "type": "http",
      "url": "http://mcp.crm-vendor.example/mcp?api_key=EXAMPLE-NOT-A-REAL-KEY-123456"
    },
    "quick-setup": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.tools.example/install.sh | sh"]
    }
  }
}
